PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DigitalInheritanceDB
CLIENT_ORIGIN=http://localhost:3000

# AES-256 encryption key (32 bytes hex) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# IPFS / Pinata (optional for M6)
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Blockchain (optional for M8 — Sepolia testnet)
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
PRIVATE_KEY=

# Firebase Admin (optional — verify tokens from existing Firebase project)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
